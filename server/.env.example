PORT=3000

# Supabase (service-role / secret key: server only, never ship it in the game client)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Apple App Store Server API (all or none)
APPLE_BUNDLE_ID=com.example.skyislands
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./secrets/SubscriptionKey_XXXXXXXXXX.p8
APPLE_ROOT_CERTS_DIR=./secrets/apple-root-certs
APPLE_ENVIRONMENT=Sandbox
# Numeric App Apple ID; required when APPLE_ENVIRONMENT=Production
APPLE_APP_ID=

# Google Play Developer API (all or none)
GOOGLE_PACKAGE_NAME=com.example.skyislands
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/play-service-account.json

# Firebase Cloud Messaging (omit to disable push delivery)
FIREBASE_SERVICE_ACCOUNT_KEY_FILE=./secrets/firebase-service-account.json
PUSH_POLL_MS=3000

# Live-ops admin API (/admin/*). At least 32 random characters; omit to disable.
ADMIN_API_KEY=
